# Copy to .env and fill in real values. Do NOT commit .env.
# SECRET_KEY is now mandatory — the app refuses to boot without it.
SECRET_KEY=replace-with-a-fresh-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=demo.eopson.gr
CSRF_TRUSTED_ORIGINS=https://demo.eopson.gr

# Media storage. Leave the bucket blank to keep uploads on local disk (MEDIA_ROOT).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
